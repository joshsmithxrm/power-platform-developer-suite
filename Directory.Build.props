<Project>
  <PropertyGroup>
    <!-- Shared settings for all projects -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Audit only direct package references for vulnerabilities. Transitive
         advisories are tracked separately via Dependabot and explicit
         full dependency graph vulnerability checks.
         The Dependabot config that backs this trade-off lives at
         .github/dependabot.yml (NuGet ecosystem, weekly). If you're considering
         removing or weakening that file, flip this back to 'all' first. -->
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>
</Project>
