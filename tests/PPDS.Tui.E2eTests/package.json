{
  "name": "ppds-tui-e2e",
  "version": "1.0.0",
  "description": "End-to-end visual tests for PPDS TUI using tui-test",
  "private": true,
  "type": "module",
  "overrides": {
    "@microsoft/tui-test": {
      "@homebridge/node-pty-prebuilt-multiarch": "0.14.1"
    }
  },
  "scripts": {
    "test": "npx @microsoft/tui-test",
    "test:update": "npx @microsoft/tui-test --updateSnapshot",
    "test:headed": "npx @microsoft/tui-test"
  },
  "devDependencies": {
    "@microsoft/tui-test": "^0.0.1-rc.5",
    "@playwright/test": "^1.40.0",
    "@xterm/xterm": "^5.5.0"
  }
}
