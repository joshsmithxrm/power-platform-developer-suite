<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>PPDS.Cli.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- NU1702: PPDS.Plugins targets the net462 Dataverse compatibility baseline but is
         referenced transitively from net8.0+. The package contains only attributes/enums
         with no framework-specific APIs, so cross-framework reference is safe. -->
    <!-- NU1701: CoreAssemblies is excluded from compile/runtime and copied only as an
         authentic net462 metadata fixture for plug-in assembly identity tests. -->
    <NoWarn>$(NoWarn);NU1701;NU1702</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The live SELECT audit's recorded cases, replayed offline by AuditCaseReplayTests (#1639). -->
    <EmbeddedResource Include="Services/Query/Faithful/AuditRecords/select-fidelity-audit-2026-11.txt" LogicalName="AuditRecords.select-fidelity-audit-2026-11.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net462" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PPDS.Cli\PPDS.Cli.csproj" />
    <!-- Built first, run as a child process by StackProbeTests (#1952); not referenced as an assembly. -->
    <ProjectReference Include="..\PPDS.Cli.StackProbe\PPDS.Cli.StackProbe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>StackProbePath</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\PPDS.Cli.StackProbe\bin\$(Configuration)\$(TargetFramework)\PPDS.Cli.StackProbe.dll</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <Target
    Name="CopyNet462DataverseSdkTestAsset"
    AfterTargets="Build"
    Condition="'$(TargetFramework)' != ''">
    <Copy
      SourceFiles="$(PkgMicrosoft_CrmSdk_CoreAssemblies)\lib\net462\Microsoft.Xrm.Sdk.dll"
      DestinationFiles="$(OutDir)TestAssets\Microsoft.Xrm.Sdk.net462.dll" />
    <Copy
      SourceFiles="$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net462)\build\.NETFramework\v4.6.2\mscorlib.dll"
      DestinationFiles="$(OutDir)TestAssets\mscorlib.dll" />
  </Target>

  <ItemGroup>
    <!-- Shared hang guard for tests that wait on a completion signal (#1684). -->
    <Compile Include="..\Shared\HangBackstop.cs" Link="Shared\HangBackstop.cs" />
  </ItemGroup>

</Project>
