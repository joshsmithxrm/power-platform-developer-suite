{
  "safety": {
    "shakedown_safe_envs": [],
    "readonly_env_var": "PPDS_SHAKEDOWN"
  },
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(dir:*)",
      "Bash(cd:*)",
      "Bash(pwd:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(less:*)",
      "Bash(more:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(which:*)",
      "Bash(where:*)",
      "Bash(grep:*)",
      "Bash(findstr:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(test:*)",
      "Bash([:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git describe:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree list:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet clean:*)",
      "Bash(npm ci)",
      "Bash(npm run compile --prefix src/PPDS.Extension)",
      "Bash(npm run typecheck:all --prefix src/PPDS.Extension)",
      "Bash(npm run lint --prefix src/PPDS.Extension)",
      "Bash(npm run lint:css --prefix src/PPDS.Extension)",
      "Bash(npm run dead-code --prefix src/PPDS.Extension)",
      "Bash(npm run test --prefix src/PPDS.Extension)",
      "Bash(npm run compile)",
      "Bash(npm run typecheck)",
      "Bash(npm run typecheck:all)",
      "Bash(npm run lint)",
      "Bash(npm run lint:css)",
      "Bash(npm run test)",
      "Bash(npm run ext:compile)",
      "Bash(npm run ext:test)",
      "Bash(npm run ext:test:e2e)",
      "Bash(npm run tui:test)",
      "Bash(npm test:*)",
      "Bash(tsc:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr status:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue status:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",
      "Bash(gh auth status)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(gh label list:*)",
      "Bash(actionlint:*)",
      "Bash(yamllint:*)",
      "WebSearch"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(dotnet nuget push:*)",
      "Bash(npm publish:*)",
      "Bash(npm install -g:*)",
      "Bash(Publish-Module:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(Invoke-WebRequest:*)",
      "Bash(chmod 777:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(rm -rf /:*)",
      "Bash(ppds data truncate:*)"
    ],
    "ask": [
      "Bash(git merge:*)",
      "Bash(git rebase -i:*)",
      "Bash(git rebase --interactive:*)",
      "Bash(git rebase --onto:*)",
      "Bash(git rebase --root:*)",
      "Bash(git rebase --exec:*)",
      "Bash(git reset:*)",
      "Bash(git apply:*)",
      "Bash(git am:*)",
      "Bash(git tag -d:*)",
      "Bash(git tag -fa:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh issue close:*)",
      "Bash(gh release create:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo delete:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/snk-protect.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/shakedown-safety.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
